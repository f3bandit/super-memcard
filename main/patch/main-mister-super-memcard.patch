diff --git a/smc_frontport.cpp b/smc_frontport.cpp
new file mode 100644
index 0000000..7c6704a
--- /dev/null
+++ b/smc_frontport.cpp
@@ -0,0 +1,88 @@
+// Super MemCard: the front ports from a MiSTer Main (smc_frontport.h). Copyright (C) 2026 f3bandit.
+// GPL-3.0-or-later, as Main_MiSTer.
+#include "smc_frontport.h"
+
+#include <unistd.h>
+
+#include "hardware.h"   // GetTimer, CheckTimer
+#include "spi.h"        // spi_uio_cmd_cont, spi_w, DisableIO
+
+// the driver's commands (core/sys/smc_port.sv)
+#define SMC_ID          0x80   // reply: 534D ('SM'), version, mode
+#define SMC_MODE        0x81   // write: bit 0 = the front ports are the driver's
+#define SMC_RAW         0x87   // write: {port 2, len}, {speed, ack wait in 10.24 us units}, the bytes as words
+#define SMC_RAW_STATUS  0x88   // reply: {busy, done, count}, then the card's bytes as words
+
+static int ver = -1;            // the driver's version in the loaded core; 0: none; -1: not asked yet
+static unsigned long next_probe;
+static int held;
+
+void smc_frontport_reset() { ver = -1; }
+
+// Asked again at most once a second while the answer is "no": right after Main loads a core it may not answer yet
+static int present()
+{
+	if (ver == 0 && CheckTimer(next_probe)) ver = -1;
+	if (ver < 0)
+	{
+		next_probe = GetTimer(1000);
+		// the answer to a word comes back with that same word (as with hps_io's own commands): the command word
+		// itself returns the first reply word
+		uint16_t id = spi_uio_cmd_cont(SMC_ID);
+		uint16_t v = spi_w(0);
+		DisableIO();
+		ver = (id == 0x534D && v) ? v : 0;
+	}
+	return ver > 0;
+}
+
+void smc_frontport_hold(int on)
+{
+	if (on == held) return;
+	if (present())
+	{
+		spi_uio_cmd_cont(SMC_MODE); spi_w(on ? 1 : 0); DisableIO();
+		if (on) usleep(50000);   // a card just switched onto the bus misses the first frame (seen on the SS1)
+	}
+	held = on;
+}
+
+int smc_frontport_raw(int port, const uint8_t *out, uint8_t *in, int len, int ack_ms, int speed)
+{
+	if (!present() || ver < 2) return -1;
+	if (speed < 0 || speed > 3 || ver < 3) speed = 0;   // speeds: driver version 3
+	if (len == 0) return 0;
+	if (len < 0 || len > 255 || (port != 1 && port != 2)) return -1;
+	int mine = !held;
+	if (mine)
+	{
+		spi_uio_cmd_cont(SMC_MODE); spi_w(1); DisableIO();
+		usleep(50000);
+	}
+
+	spi_uio_cmd_cont(SMC_RAW);
+	spi_w((port == 2 ? 0x100 : 0) | len);
+	spi_w((uint16_t)(speed << 14 | (ack_ms > 167 ? 167 : ack_ms) * 100000 / 1024));   // units of 10.24 us
+	for (int k = 0; k < len; k += 2) spi_w((uint16_t)(out[k] | ((k + 1 < len ? out[k + 1] : 0) << 8)));
+	DisableIO();
+
+	int count = -3;
+	unsigned long until = GetTimer(2000 + ack_ms * 4);
+	while (!CheckTimer(until))
+	{
+		usleep(500);
+		uint16_t st = spi_uio_cmd_cont(SMC_RAW_STATUS);
+		if ((st & 0x8000) || !(st & 0x4000)) { DisableIO(); continue; }   // busy, or not done yet
+		count = st & 0xFF;
+		for (int k = 0; k < len; k += 2)
+		{
+			uint16_t w = spi_w(0);
+			in[k] = w & 0xFF;
+			if (k + 1 < len) in[k + 1] = w >> 8;
+		}
+		DisableIO();
+		break;
+	}
+	if (mine) { spi_uio_cmd_cont(SMC_MODE); spi_w(0); DisableIO(); }
+	return count;
+}
diff --git a/smc_frontport.h b/smc_frontport.h
new file mode 100644
index 0000000..4d553c3
--- /dev/null
+++ b/smc_frontport.h
@@ -0,0 +1,17 @@
+// Super MemCard: the SuperStation One's front ports from a MiSTer Main, through the front-port driver in the loaded
+// core (core/sys/smc_port.sv: in the menu core on hps_io's EXT_BUS, in a game core in sys_top). Copyright (C) 2026
+// f3bandit. GPL-3.0-or-later, as Main_MiSTer.
+#pragma once
+#include <stdint.h>
+
+// One raw frame on front port 1 or 2: out[0..len-1] in one select, the card's byte for each into in[], stopping after
+// the first byte the card doesn't ACK. ack_ms: how long a byte's ACK may take (1..167). speed: 0 as a PS1 (250 kHz),
+// 1 500 kHz, 2 1 MHz, 3 2 MHz. Returns the bytes exchanged (0: nothing answered); -1 no driver in this core (len 0
+// only asks that), -2 busy, -3 no answer from the driver in time.
+int smc_frontport_raw(int port, const uint8_t *out, uint8_t *in, int len, int ack_ms, int speed);
+
+// Keep the front ports switched to the driver (1) across several frames, or give them back to the core (0).
+void smc_frontport_hold(int on);
+
+// Forget what the loaded core answered (call when another core is loaded).
+void smc_frontport_reset();
diff --git a/smc_osd.cpp b/smc_osd.cpp
new file mode 100644
index 0000000..17b58bb
--- /dev/null
+++ b/smc_osd.cpp
@@ -0,0 +1,172 @@
+// Super MemCard: the OSD's Saves page (smc_osd.h). Copyright (C) 2026 f3bandit. GPL-3.0-or-later, as Main_MiSTer.
+#include "smc_osd.h"
+
+#include <linux/input.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "osd.h"       // OsdWrite, OsdSetTitle, OsdGetSize, OsdUpdate, ScrollText, ScrollReset
+#include "smc_shim.h"
+
+#define MAX_SAVES 100
+
+struct save_row
+{
+	int card;      // the virtual card
+	int files;
+	long time;     // its newest file's time; 0 for the new one
+	int playing;   // the one the game runs with now
+	int is_new;    // "New save": the first free card, the game starts with no save
+	char label[25];   // the name the user gave it (the memory manager's Rename), "" if none
+};
+
+#define ROW_W  29   // a row's characters on the OSD (its last columns stay clear)
+
+static save_row rows[MAX_SAVES + 1];
+static int nrows, sel, top, confirm = -1;
+static char game[128];
+static char msg[40];   // on the page's last row (Main's Info() pop-up doesn't show over a menu page)
+
+static void say(const char *m) { snprintf(msg, sizeof(msg), " %s", m); }
+
+bool smc_osd_available()
+{
+	return smc_shim_saves_available();
+}
+
+int smc_osd_open()
+{
+	static char ans[8192];
+	nrows = sel = top = 0;
+	confirm = -1;
+	game[0] = msg[0] = 0;
+	ScrollReset();
+	// what's wrong is said on the page itself (no rows then)
+	if (smc_shim_ask("SAVES", ans, sizeof(ans)) < 0) { say("The card didn't answer"); return 1; }
+	if (!strncmp(ans, "nocard", 6)) { say("No memory card in the port"); return 1; }
+	if (!strncmp(ans, "notgenuine", 10)) { say("Not a Retro Remake card"); return 1; }
+	if (!strncmp(ans, "nogame", 6)) { say("No saves for it on the card"); return 1; }
+	int new_card = 0;
+	for (char *l = strtok(ans, "\n"); l; l = strtok(NULL, "\n"))
+	{
+		int card, files, playing;
+		long t;
+		char sys[64], name[128], label[25] = "";
+		if (sscanf(l, "save\t%d\t%d\t%ld\t%d\t%24[^\n]", &card, &files, &t, &playing, label) >= 4 && nrows < MAX_SAVES)
+		{
+			save_row &r = rows[nrows++];
+			memset(&r, 0, sizeof(r));
+			r.card = card;
+			r.files = files;
+			r.time = t;
+			r.playing = playing;
+			snprintf(r.label, sizeof(r.label), "%s", label);
+		}
+		else if (sscanf(l, "game\t%63[^\t]\t%127[^\n]", sys, name) == 2)
+			snprintf(game, sizeof(game), "%s", name);
+		else if (sscanf(l, "new\t%d", &card) == 1)
+			new_card = card;
+	}
+	if (new_card)   // last: rows has room for it
+	{
+		save_row &r = rows[nrows++];
+		memset(&r, 0, sizeof(r));
+		r.card = new_card;
+		r.is_new = 1;
+	}
+	if (!nrows) say("No saves for it on the card");
+	for (int i = 0; i < nrows; i++) if (rows[i].playing) sel = i;
+	return 1;
+}
+
+static int list_rows() { return OsdGetSize() - 3; }   // the game's name and a gap above, the hint below
+
+static void fit()
+{
+	if (sel < 0) sel = 0;
+	if (sel >= nrows) sel = nrows - 1;
+	if (sel < top) top = sel;
+	if (sel >= top + list_rows()) top = sel - list_rows() + 1;
+	if (top < 0) top = 0;
+}
+
+// a row's whole text: " Card 2  now  Speedrun  Oct 05 2026 20:47". Its head (" Card 2  now  ") stays put; the rest,
+// the name and the date, scrolls on the selected row when it's longer than the OSD. Returns the head's length
+static int row_text(const save_row &r, char *s, size_t n)
+{
+	if (r.is_new) { snprintf(s, n, " New save (card %d)", r.card); return 0; }
+	char when[24] = "";
+	time_t t = (time_t)r.time;
+	if (r.files && t) strftime(when, sizeof(when), "%b %d %Y %H:%M", localtime(&t));
+	int head = snprintf(s, n, " Card %-2d  %s", r.card, r.playing ? "now  " : "");
+	snprintf(s + head, n - head, "%s%s%s", r.label, r.label[0] ? "  " : "", r.files ? when : "empty");
+	return head;
+}
+
+void smc_osd_scroll()
+{
+	if (sel < 0 || sel >= nrows || msg[0] || confirm == sel) return;   // the hint row speaks: the row stays still
+	char s[96];
+	int head = row_text(rows[sel], s, sizeof(s));
+	int len = (int)strlen(s);
+	if (len > ROW_W) ScrollText(2 + sel - top, s, head, len, ROW_W + 1, 1);
+}
+
+void smc_osd_print()
+{
+	char s[64];
+	fit();
+	OsdSetTitle("Saves");
+	snprintf(s, sizeof(s), " %.27s", game);
+	OsdWrite(0, s, 0, 1);
+	OsdWrite(1, "");
+	for (int i = 0; i < list_rows(); i++)
+	{
+		int k = top + i;
+		if (k >= nrows) { OsdWrite(2 + i, ""); continue; }
+		char full[96];
+		row_text(rows[k], full, sizeof(full));
+		snprintf(s, sizeof(s), "%.*s", ROW_W, full);   // cut to the OSD; the selected one scrolls (smc_osd_scroll)
+		OsdWrite(2 + i, s, k == sel, 0);
+	}
+	const char *hint = msg[0] ? msg : confirm == sel ? " Again: restart with this save" : nrows > list_rows() ? " More: up/down" : "";
+	OsdWrite(OsdGetSize() - 1, hint, msg[0] || confirm == sel, 0);
+}
+
+int smc_osd_key(int up, int down, int key, int select)
+{
+	int was = sel;
+	if (up) sel--;
+	if (down) sel++;
+	if (key == KEY_PAGEUP || key == KEY_LEFT) sel -= list_rows();
+	if (key == KEY_PAGEDOWN || key == KEY_RIGHT) sel += list_rows();
+	if (key == KEY_HOME) sel = 0;
+	if (key == KEY_END) sel = nrows - 1;
+	fit();
+	if (sel != was) { confirm = -1; msg[0] = 0; ScrollReset(); return 1; }
+	if (!select || !nrows) return 0;
+
+	const save_row &r = rows[sel];
+	if (r.playing) { say("Already running this save"); return 1; }
+	if (confirm != sel) { confirm = sel; msg[0] = 0; return 1; }   // asked first: a game restarts, its unsaved progress is lost
+
+	// the system's saves move between cards: seconds (more with many saves). Said on the page before Main waits
+	char cmd[32], ans[256];
+	say("Switching saves...");
+	smc_osd_print();
+	OsdUpdate();
+	snprintf(cmd, sizeof(cmd), "USE %d", r.card);
+	if (smc_shim_ask(cmd, ans, sizeof(ans), 600000) < 0 || strncmp(ans, "use ok", 6))
+	{
+		confirm = -1;
+		say("Couldn't switch the save");
+		return 1;
+	}
+	say("Restarting the game...");
+	smc_osd_print();
+	OsdUpdate();
+	smc_shim_restart();   // Main starts again with the game
+	return 1;
+}
diff --git a/smc_osd.h b/smc_osd.h
new file mode 100644
index 0000000..efa9df2
--- /dev/null
+++ b/smc_osd.h
@@ -0,0 +1,31 @@
+// Super MemCard in a MiSTer Main: the OSD's Saves page. Copyright (C) 2026 f3bandit. GPL-3.0-or-later, as Main_MiSTer.
+//
+// While a game whose saves are on the card runs, the core's OSD page gets a "Saves" entry. It lists that game's saves,
+// one per virtual card on the card, and a new one on the first free card. Picking one restarts the game with that
+// save (smcd puts it in place first; this SuperStation's save goes to its card before).
+//
+// In Main's menu.cpp (the same as its Cheats page):
+//   on the core's main OSD page, after its options:   if (!page && smc_osd_available()) { saves_row = selentry; MenuWrite(entry++, " Saves", menusub == selentry++, 0); ... }
+//   on select of that row:                             if (smc_osd_open()) { menusub = 0; menustate = MENU_SMC_SAVES1; }
+//   MENU_SMC_SAVES1:                                   smc_osd_print(); menustate = MENU_SMC_SAVES2;
+//   MENU_SMC_SAVES2:                                   menu/back: the core's page again; else smc_osd_scroll();
+//                                                      if (smc_osd_key(up, down, c, select)) menustate = MENU_SMC_SAVES1;
+#pragma once
+
+// a game with its saves on the card is running: the core's OSD page shows "Saves"
+bool smc_osd_available();
+
+// asks smcd for the game's saves: 1 to show the page (when something's wrong, the page says so instead of a list)
+int smc_osd_open();
+
+// draws the page (title, the game, its saves, the hint)
+void smc_osd_print();
+
+// from the page's loop (MENU_SMC_SAVES2, every pass): the selected row scrolls when it's longer than the OSD (its name
+// and date), as Main's file names do
+void smc_osd_scroll();
+
+// a key on the page (up, down, the key code for page up/down/home/end, select): 1 when it needs drawing again.
+// Select on a save asks first ("again: restart"), then restarts the game with it (Main starts again). Its messages are
+// on the page's last row: Main's Info() pop-up doesn't show over a menu page.
+int smc_osd_key(int up, int down, int key, int select);
