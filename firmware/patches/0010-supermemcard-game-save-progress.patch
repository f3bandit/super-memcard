+/* A game saving to the card (PS1 mode): its percentage while it writes, -1 when it isn't. A save is a burst of sector
+   writes; it ends 0.8 s after the last one (100% from 0.3 s). Its size isn't known ahead: the bar fills a block (64
+   sectors, 8 KB) at a time, the directory's sectors not counted. */
+static int game_save_pct(void) {
+    static bool active;
+    static uint32_t last_all, base;
+    static uint64_t last_us;
+    uint32_t all, data;
+    uint64_t now = time_us_64();
+    if (settings_get_mode(true) != MODE_PS1)
+        return -1;
+    ps1_mc_data_interface_game_writes(&all, &data);
+    if (all != last_all) {
+        if (!active) {
+            active = true;
+            base = data;
+        }
+        last_all = all;
+        last_us = now;
+    }
+    if (!active)
+        return -1;
+    if (now - last_us > 800 * 1000) {
+        active = false;
+        return -1;
+    }
+    if (now - last_us > 300 * 1000)
+        return 100;
+    uint32_t done = data - base, total = done ? (done + 63) / 64 * 64 : 64;
+    int pct = (int)(done * 100 / total);
+    return pct > 99 ? 99 : pct;
+}
