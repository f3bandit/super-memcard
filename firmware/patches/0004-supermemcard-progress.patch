+#if WITH_SUPERMEMCARD
+/* the SS1's progress bar (Super MemCard's Progress): over whichever screen is up, back to it when done */
+static lv_obj_t *scr_smc_progress, *smc_prog_bar, *smc_prog_text, *smc_prog_pct;
+
+static void create_smc_progress_screen(void) {
+    scr_smc_progress = ui_scr_create();
+    ui_header_create(scr_smc_progress, "SuperStation", true);
+    static lv_style_t style_progress;
+    lv_style_init(&style_progress);
+    lv_style_set_line_width(&style_progress, 12);
+    lv_style_set_line_color(&style_progress, lv_palette_main(LV_PALETTE_BLUE));
+    smc_prog_bar = lv_line_create(scr_smc_progress);
+    lv_obj_set_width(smc_prog_bar, DISPLAY_WIDTH);
+    lv_obj_add_style(smc_prog_bar, &style_progress, 0);
+    smc_prog_text = lv_label_create(scr_smc_progress);
+    lv_obj_set_align(smc_prog_text, LV_ALIGN_TOP_LEFT);
+    lv_obj_set_pos(smc_prog_text, 0, 14);
+    lv_obj_set_width(smc_prog_text, DISPLAY_WIDTH);
+    lv_label_set_long_mode(smc_prog_text, LV_LABEL_LONG_DOT);   /* still: a scrolling line would be redrawn between blocks */
+    lv_label_set_text(smc_prog_text, "");
+    smc_prog_pct = lv_label_create(scr_smc_progress);
+    lv_obj_set_align(smc_prog_pct, LV_ALIGN_TOP_LEFT);
+    lv_obj_set_pos(smc_prog_pct, 0, DISPLAY_HEIGHT - 9);
+    lv_label_set_text(smc_prog_pct, "");
+}
+
+/* the bar and text as the SS1 last sent them */
+static void update_smc_progress(int pct, const char *text) {
+    static lv_point_t pts[2] = {{0, DISPLAY_HEIGHT / 2 + 4}, {0, DISPLAY_HEIGHT / 2 + 4}};
+    static int shown = -2;
+    static char shown_text[SMC_PROGRESS_TEXT + 1];
+    if (pct != shown) {
+        shown = pct;
+        pts[1].x = (lv_coord_t)(DISPLAY_WIDTH * pct / 100);
+        lv_line_set_points(smc_prog_bar, pts, 2);
+        static char p[8];
+        snprintf(p, sizeof(p), "%d%%", pct);
+        lv_label_set_text(smc_prog_pct, p);
+    }
+    if (strcmp(text, shown_text)) {
+        snprintf(shown_text, sizeof(shown_text), "%s", text);
+        lv_label_set_text(smc_prog_text, shown_text);
+    }
+}
+#endif
